{
	"extends": "@sindresorhus/tsconfig/tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"esModuleInterop": true,
		"lib": ["es2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noErrorTruncation": true,
		"types": [
			"babel__core",
			"babel__generator",
			"babel__template",
			"babel__traverse",
			"chrome",
			"color",
			"color-convert",
			"color-name",
			"combinations",
			"eslint",
			"estree",
			"filesystem",
			"filewriter",
			"har-format",
			"intersect",
			"istanbul-lib-coverage",
			"istanbul-lib-report",
			"istanbul-reports",
			"jest",
			"jest-environment-puppeteer",
			"jsdom",
			"json-schema",
			"json5",
			"lodash",
			"minimatch",
			"node",
			"normalize-package-data",
			"puppeteer",
			"react",
			"react-dom",
			"stack-utils",
			"tough-cookie",
			"webextension-polyfill",
			"yargs",
			"yargs-parser",
			"yauzl"
		]
	},
	"exclude": ["node_modules", "dist", "daemon", "cli", "shared"]
}
